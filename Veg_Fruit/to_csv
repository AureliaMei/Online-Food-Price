import os
import json
import pandas as pd
import re

# --- CONFIGURATION ---
# Matching your naming convention: 'Veg_Fruit'
TARGET_FOLDER = "Veg_Fruit" 

def clean_price(val):
    """Standardizes price strings (e.g., '39.900 ₫') into floats (39900.0)."""
    if not val or pd.isna(val) or val == "":
        return 0.0
    # Remove dots, currency symbols, and non-breaking spaces
    digits = re.sub(r'[^\d]', '', str(val))
    return float(digits) if digits else 0.0

def process_veg_fruits():
    base_path = os.getcwd()
    
    # Path logic to find subfolders correctly
    if base_path.endswith(TARGET_FOLDER):
        json_dir, csv_dir = "JSON", "CSV"
    else:
        json_dir = os.path.join(TARGET_FOLDER, "JSON")
        csv_dir = os.path.join(TARGET_FOLDER, "CSV")
    
    if not os.path.exists(json_dir):
        print(f"❌ Error: JSON folder not found at {os.path.abspath(json_dir)}")
        return
        
    if not os.path.exists(csv_dir):
        os.makedirs(csv_dir)

    processed_count = 0
    for filename in os.listdir(json_dir):
        if filename.endswith(".json"):
            json_path = os.path.join(json_dir, filename)
            csv_path = os.path.join(csv_dir, filename.replace(".json", ".csv"))

            if os.path.exists(csv_path):
                continue

            with open(json_path, 'r', encoding='utf-8') as f:
                try:
                    run_data = json.load(f)
                    if run_data.get('status') != 'success':
                        continue

                    raw_list = run_data.get('data', {}).get('listData', {}).get('List Data 1', [])
                    cleaned_rows = []

                    for item in raw_list:
                        # 1. Map Veg + Fruits named keys
                        p_final_raw = clean_price(item.get('Final Price'))
                        p_marked_raw = clean_price(item.get('Marked Price'))

                        # 2. Price Logic: Lower is actual, Higher is marked
                        if p_final_raw > 0 and p_marked_raw > 0:
                            final, marked = min(p_final_raw, p_marked_raw), max(p_final_raw, p_marked_raw)
                        else:
                            final = p_final_raw if p_final_raw > 0 else p_marked_raw
                            marked = p_marked_raw if (p_marked_raw > p_final_raw and p_final_raw > 0) else None

                        cleaned_rows.append({
                            'product_name': item.get('Product Name'),
                            'unit': item.get('Unit'),
                            'final_price': final,
                            'marked_price': marked,
                            'product_url': item.get('Product URL'),
                            'deal': '',  # No explicit deal field in this robot sample
                            'gift_price': 0.0,
                            'scrape_timestamp': run_data.get('startedAt'),
                            'run_id': run_data.get('id')
                        })

                    if cleaned_rows:
                        df = pd.DataFrame(cleaned_rows)
                        # Ensure columns are in the same order as your other robots
                        column_order = [
                            'product_name', 'unit', 'final_price', 'marked_price', 
                            'product_url', 'deal', 'gift_price', 'scrape_timestamp', 'run_id'
                        ]
                        df = df[column_order]
                        df.to_csv(csv_path, index=False, encoding='utf-8-sig')
                        processed_count += 1
                        print(f"  ✅ Refined: {filename}")

                except Exception as e:
                    print(f"  ⚠️ Error in {filename}: {e}")
    
    print(f"\n🚀 Done! Processed {processed_count} Veg + Fruit files into {csv_dir}")

if __name__ == "__main__":
    process_veg_fruits()