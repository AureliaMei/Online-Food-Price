import os
import json
import pandas as pd
import re

def clean_price(val):
    """Turns '49.000 ₫' into 49000.0"""
    if not val or pd.isna(val) or val == "":
        return 0.0
    digits = re.sub(r'[^\d]', '', str(val))
    return float(digits) if digits else 0.0

def process_and_save():
    # Get the directory where this script is running
    base_path = os.getcwd()

    # Scan all folders in the current directory
    for folder_name in os.listdir(base_path):
        category_path = os.path.join(base_path, folder_name)

        # We only care about directories (e.g., "Baby_product")
        if not os.path.isdir(category_path):
            continue

        # Check if this folder has a "JSON" subfolder
        json_dir = os.path.join(category_path, "JSON")
        if not os.path.exists(json_dir):
            continue  # Skip folders that aren't robot data

        # Define the sibling "CSV" directory
        csv_dir = os.path.join(category_path, "CSV")
        
        # Create CSV folder if it doesn't exist
        if not os.path.exists(csv_dir):
            os.makedirs(csv_dir)
            print(f"📁 Created folder: {csv_dir}")

        print(f"🔍 Scanning category: {folder_name}...")

        # Process files inside the JSON folder
        files_found = 0
        for file in os.listdir(json_dir):
            if file.endswith(".json"):
                files_found += 1
                json_path = os.path.join(json_dir, file)
                
                # Create CSV filename matching the JSON name
                csv_filename = file.replace(".json", ".csv")
                csv_path = os.path.join(csv_dir, csv_filename)

                # SKIP if CSV already exists
                if os.path.exists(csv_path):
                    continue

                try:
                    with open(json_path, 'r', encoding='utf-8') as f:
                        run_data = json.load(f)
                        
                        # 1. Skip failed runs
                        if run_data.get('status') != 'success':
                            continue

                        # 2. Extract Data
                        # Adjust 'List Data 1' if your robot uses a different list name
                        raw_list = run_data.get('data', {}).get('listData', {}).get('List Data 1', [])
                        cleaned_rows = []

                        for item in raw_list:
                            # Standardizing WinMart Labels
                            p1 = clean_price(item.get('Label 7'))
                            p2 = clean_price(item.get('Label 8'))

                            # Price Comparison Logic
                            if p2 > 0 and p2 > p1:
                                final, marked = p1, p2
                            elif p1 > 0 and p1 > p2 and p2 != 0:
                                final, marked = p2, p1
                            else:
                                final, marked = (p1 if p1 > 0 else p2), None

                            cleaned_rows.append({
                                'product_name': item.get('Label 5'),
                                'unit': item.get('Label 6'),
                                'final_price': final,
                                'marked_price': marked,
                                'product_url': item.get('Label 4'),
                                'scrape_timestamp': run_data.get('startedAt'),
                                'run_id': run_data.get('id')
                            })

                        # 3. Save as CSV
                        if cleaned_rows:
                            df = pd.DataFrame(cleaned_rows)
                            df.to_csv(csv_path, index=False, encoding='utf-8-sig')
                            print(f"  ✅ Created: {csv_filename}")

                except Exception as e:
                    print(f"  ⚠️ Error on {file}: {e}")
        
        if files_found == 0:
            print("  (No JSON files found)")

if __name__ == "__main__":
    process_and_save()