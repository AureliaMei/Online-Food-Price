import pandas as pd
import glob
import os
import re
from collections import Counter
from nltk.util import ngrams

# --- CONFIGURATION ---
folder_path = '/Users/my/Online Food Price/Baby_product/CSV'
file_pattern = os.path.join(folder_path, '*.csv')
output_file = 'baby_product_analysis_cleaned.csv'

# Add any other words here that you want to ignore
EXCLUDE_WORDS = {'hộp', 'lốc', 'ml', 'g', 'kg', 'chai', 'túi', 'lon', 'miếng', 'gói', 'bịch', 'cái', 'viên', 'ống', 'hủ', 'bình', 'set', 'bộ', 'cặp', 'quyển', 'cuốn', 'trẻ','p'}

def clean_vietnamese_text(text):
    text = str(text).lower()
    # Keep Vietnamese characters and spaces
    text = re.sub(r'[^a-záàảãạăắằẳẵặâấầẩẫậéèẻẽẹêếềểễệíìỉĩịóòỏõọôốồổỗộơớờởỡợúùủũụưứừửữựýỳỷỹỵđ\s]', ' ', text)
    # Remove extra whitespace
    text = " ".join(text.split())
    return text

def main():
    csv_files = glob.glob(file_pattern)
    if not csv_files:
        print(f"No CSV files found in {folder_path}.")
        return

    print(f"Processing {len(csv_files)} files...")
    
    all_names = []
    for file in csv_files:
        try:
            df = pd.read_csv(file, encoding='utf-8-sig')
            if 'product_name' in df.columns:
                all_names.extend(df['product_name'].dropna().tolist())
        except Exception as e:
            print(f"Skipping {file} due to error: {e}")

    # 1. Clean and Filter Words
    full_text = " ".join(all_names)
    cleaned_text = clean_vietnamese_text(full_text)
    
    # Split into words and remove excluded units
    # This also removes words that are purely numbers
    words = [w for w in cleaned_text.split() if w not in EXCLUDE_WORDS and not w.isdigit()]

    # 2. Generate N-grams (2 to 5 words)
    ngram_data = []
    for n in range(2, 4):
        print(f"Generating {n}-word combinations...")
        counts = Counter(ngrams(words, n))
        
        for combo, freq in counts.items():
            ngram_data.append({
                'combination': " ".join(combo),
                'word_count': n,
                'frequency': freq
            })

    # 3. Create DataFrame and Sort
    results_df = pd.DataFrame(ngram_data)
    
    # Sorting by frequency DESC (Most frequent first is usually better for finding categories)
    # But I kept the logic available if you still want ASC.
    results_df = results_df.sort_values(by='frequency', ascending=False)

    # 4. Save with proper encoding for Excel
    results_df.to_csv(output_file, index=False, encoding='utf-8-sig')
    print(f"\nAnalysis complete! Results saved to: {output_file}")
    
    # Show top 20 to verify if units are gone
    print("\nPreview of top combinations:")
    print(results_df.head(20))

if __name__ == "__main__":
    main()