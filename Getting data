def get_safe_date(date_str):
    """Parses API date string into YYYY-MM-DD format."""
    try:
        # Tries to handle '1/30/2026, 2:56:52 PM' format
        clean_date = date_str.split(',')[0].strip()
        dt_obj = datetime.strptime(clean_date, '%m/%d/%Y')
        return dt_obj.strftime('%Y-%m-%d')
    except Exception:
        return "date_unknown"

def sync_robot_data(name, r_id):
    # 1. Setup Directory: ./CategoryName/JSON/
    # We use pathlib for cleaner path handling
    save_dir = Path(f"./{name}/JSON")
    save_dir.mkdir(parents=True, exist_ok=True)
    
    # 2. Map existing Run IDs from filenames
    # Scans for files like: run_2026-01-30_e4b23364.json
    local_ids = set()
    for f in save_dir.glob("run_*.json"):
        try:
            # Splits filename by '_' and takes the last part (the ID)
            run_id_part = f.stem.split('_')[-1]
            local_ids.add(run_id_part)
        except:
            pass

    print(f"🔍 {name}: Found {len(local_ids)} local runs. Checking server...")
    
    try:
        # 3. Fetch Runs from API
        # limit=5000 ensures we get older runs if this is the first time
        # sort=startedAt:desc helps us see the newest ones first
        url = f"{BASE_URL}/robots/{r_id}/runs?limit=5000&sort=startedAt:desc&order=DESC"
        response = requests.get(url, headers=HEADERS)
        
        if response.status_code != 200:
            print(f"  ❌ API Error {response.status_code}")
            return

        payload = response.json()
        runs_list = payload.get('runs', {}).get('items', [])
        
        if not runs_list:
            print(f"  ⚠️ No runs found on server.")
            return

        # 4. Process runs (Iterate to save missing ones)
        new_files_count = 0
        
        for run in runs_list:
            run_id = str(run.get('id'))
            status = run.get('status')
            
            # OPTIONAL: Only save if status is SUCCESS? 
            # If you want failed runs too, remove the 'if status == success' check.
            if status.lower() != 'success':
                continue

            # If we don't have this ID locally, save it
            if run_id not in local_ids:
                # Format Date
                created_at_raw = run.get('startedAt', '')
                formatted_date = get_safe_date(created_at_raw)

                # Construct Filename
                file_name = f"run_{formatted_date}_{run_id}.json"
                file_path = save_dir / file_name

                # Save File
                with open(file_path, "w", encoding="utf-8") as f:
                    json.dump(run, f, ensure_ascii=False, indent=4)
                
                new_files_count += 1
                local_ids.add(run_id) # Add to set to prevent dupes in same session

        if new_files_count > 0:
            print(f"  📥 DOWNLOADED {new_files_count} NEW runs.")
        else:
            print(f"  ✨ Up to date (Server has {len(runs_list)} runs).")

    except Exception as e:
        print(f"  ⚠️ Error syncing {name}: {e}")

if __name__ == "__main__":
    print("🚀 Starting Sync Job...")
    for name, r_id in ROBOTS.items():
        sync_robot_data(name, r_id)
