def backup_all_runs_as_json():
    for name, r_id in ROBOTS.items():
        if not os.path.exists(name):
            os.makedirs(name)

        print(f"🔍 Extracting {name}...")
        
        # Based on your Ping, the plural 'robots' works perfectly
        url = f"{BASE_URL}/robots/{r_id}/runs"
        response = requests.get(url, headers=HEADERS)
        
        if response.status_code != 200:
            print(f"  ❌ API Error: {response.status_code}")
            continue

        payload = response.json()
        
        # Navigate the path: payload -> runs -> items
        runs_container = payload.get('runs', {})
        runs_list = runs_container.get('items', [])
        total_available = runs_container.get('totalCount', 0)

        if not runs_list:
            print(f"  ⚠️ No runs found (Total Count: {total_available})")
            continue

        new_files_count = 0
        for run in runs_list:
            run_id = run.get('id')
            # Extract date for filename: 2026-01-30_T14-56
            created_at_raw = run.get('startedAt', 'unknown')
            
            # Formatting the date for safe filenames
            try:
                # Handling "1/30/2026, 2:56:52 PM" style from your previous snippet
                dt_obj = datetime.strptime(created_at_raw.split(',')[0], '%m/%d/%Y')
                run_date = dt_obj.strftime('%Y-%m-%d')
            except:
                run_date = "date_unknown"

            file_path = f"{name}/run_{run_date}_{run_id}.json"

            if os.path.exists(file_path):
                continue

            with open(file_path, 'w', encoding='utf-8') as f:
                json.dump(run, f, ensure_ascii=False, indent=4)
            
            new_files_count += 1

        print(f"  ✅ Finished. Total in Maxun: {total_available}. Newly saved: {new_files_count}")

if __name__ == "__main__":
    backup_all_runs_as_json()