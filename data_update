def sync_robot_data(name, r_id):
    json_dir = Path(f"./{name}/JSON")
    json_dir.mkdir(parents=True, exist_ok=True)
    
    # 1. Map existing Run IDs from filenames
    local_ids = set()
    for f in json_dir.glob("run_*.json"):
        # Extracts 'e4b23364' from 'run_2026-01-30_e4b23364.json'
        try:
            run_id_part = f.stem.split('_')[-1]
            local_ids.add(run_id_part)
        except:
            pass

    print(f"🔍 Checking {name} ({len(local_ids)} local files)...")
    
    try:
        # 2. Try to force sorting by Newest First + Large Limit
        # We add multiple params because we aren't sure which one Maxun respects
        url = f"{BASE_URL}/robots/{r_id}/runs?limit=5000&sort=startedAt:desc&order=DESC"
        response = requests.get(url, headers=HEADERS)
        
        if response.status_code != 200:
            print(f"  ❌ API Error {response.status_code}")
            return

        payload = response.json()
        runs_list = payload.get('runs', {}).get('items', [])
        
        if not runs_list:
            print(f"  ⚠️ No runs found.")
            return

        # 3. DEBUG: Print the dates of the First and Last item returned
        # This will tell us if the 'sort' parameter worked
        first_date = runs_list[0].get('startedAt', 'Unknown')
        last_date = runs_list[-1].get('startedAt', 'Unknown')
        print(f"  📊 Server sent {len(runs_list)} runs.")
        print(f"     First item date: {first_date}")
        print(f"     Last item date:  {last_date}")

        missing_count = 0
        
        # 4. Process EVERY run returned (iterating backwards just to be safe)
        for run in reversed(runs_list):
            run_id = str(run.get('id'))
            status = run.get('status')
            
            # Check strict ID match
            if run_id not in local_ids:
                if status.lower() == 'success':
                    # Format Date
                    created_at_raw = run.get('startedAt', '')
                    try:
                        date_str = created_at_raw.split(',')[0]
                        dt_obj = datetime.strptime(date_str, '%m/%d/%Y')
                        formatted_date = dt_obj.strftime('%Y-%m-%d')
                    except:
                        formatted_date = "unknown_date"

                    # Save File
                    file_name = f"run_{formatted_date}_{run_id}.json"
                    file_path = json_dir / file_name

                    with open(file_path, "w", encoding="utf-8") as f:
                        json.dump(run, f, ensure_ascii=False, indent=4)
                    
                    missing_count += 1
                    local_ids.add(run_id) # Prevent duplicates in same loop
        
        if missing_count > 0:
            print(f"  📥 DOWNLOADED {missing_count} NEW RUNS!")
        else:
            print(f"  ✨ Local matches server.")

    except Exception as e:
        print(f"  ⚠️ Error syncing {name}: {e}")

if __name__ == "__main__":
    for name, r_id in ROBOTS.items():
        sync_robot_data(name, r_id)