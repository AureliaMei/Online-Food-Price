def notify_mac(title, message):
    """Sends a native macOS notification."""
    cmd = f'display notification "{message}" with title "{title}"'
    subprocess.run(["osascript", "-e", cmd])

def trigger_robot(name, r_id):
    url = f"{BASE_URL}/robots/{r_id}/run"
    try:
        response = requests.post(url, headers=HEADERS)
        if response.status_code in [200, 201]:
            # Expecting runId in response; Adjust if your Maxun version differs
            return response.json().get('id') or response.json().get('runId')
    except Exception as e:
        print(f"Error triggering {name}: {e}")
    return None

def check_status(r_id, robot_uuid):
    """Checks if a specific run is completed."""
    url = f"{BASE_URL}/robots/{robot_uuid}/runs"
    try:
        response = requests.get(url, headers=HEADERS)
        runs = response.json().get('runs', {}).get('items', [])
        for run in runs:
            if run.get('id') == r_id:
                return run.get('status') # 'completed', 'failed', 'running', etc.
    except:
        pass
    return "unknown"

def main():
    notify_mac("Maxun Automation", "Starting 10PM Scraping...")
    
    # Tracking: {name: {'id': run_id, 'uuid': uuid, 'retry': False, 'status': 'pending'}}
    active_jobs = {}
    for name, uuid in ROBOTS.items():
        run_id = trigger_robot(name, uuid)
        active_jobs[name] = {'id': run_id, 'uuid': uuid, 'retry_done': False, 'status': 'running' if run_id else 'failed'}

    completed_count = 0
    total_robots = len(ROBOTS)

    while completed_count < total_robots:
        time.sleep(60) # Poll every minute
        for name, info in active_jobs.items():
            if info['status'] in ['completed', 'skipped']:
                continue
            
            status = check_status(info['id'], info['uuid'])
            
            if status == 'completed':
                info['status'] = 'completed'
                completed_count += 1
                print(f"✅ {name} finished.")
            
            elif status == 'failed':
                if not info['retry_done']:
                    print(f"🔄 {name} failed. Retrying once...")
                    new_id = trigger_robot(name, info['uuid'])
                    info['id'] = new_id
                    info['retry_done'] = True
                    info['status'] = 'running'
                else:
                    print(f"⚠️ {name} failed twice. Skipping.")
                    info['status'] = 'skipped'
                    completed_count += 1

    # Final Summary
    successes = [n for n, i in active_jobs.items() if i['status'] == 'completed']
    failures = [n for n, i in active_jobs.items() if i['status'] == 'skipped']
    
    msg = f"Finished: {len(successes)} Success, {len(failures)} Failed."
    notify_mac("Scraping Complete", msg)
    if failures:
        notify_mac("Warning", f"Failed robots: {', '.join(failures)}")

if __name__ == "__main__":
    main()