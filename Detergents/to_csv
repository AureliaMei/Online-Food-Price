import os
import json
import pandas as pd
import re

# --- CONFIGURATION ---
TARGET_FOLDER = "Detergents/JSON"

def clean_price(val):
    """Turns '49.500 ₫' into 49500.0"""
    if not val or pd.isna(val) or val == "":
        return 0.0
    digits = re.sub(r'[^\d]', '', str(val))
    return float(digits) if digits else 0.0

def process_detergents_to_csv():
    # 1. Path Setup
    input_dir = TARGET_FOLDER
    output_dir = os.path.join(input_dir, "CSV")
    
    if not os.path.exists(output_dir):
        os.makedirs(output_dir)
        print(f"📁 Created subfolder: {output_dir}")

    # 2. Process Files
    for filename in os.listdir(input_dir):
        if filename.endswith(".json"):
            json_path = os.path.join(input_dir, filename)
            csv_path = os.path.join(output_dir, filename.replace(".json", ".csv"))

            # Skip if already done
            if os.path.exists(csv_path):
                continue

            with open(json_path, 'r', encoding='utf-8') as f:
                try:
                    run_data = json.load(f)
                    
                    # Skip failed runs
                    if run_data.get('status') != 'success':
                        continue

                    raw_list = run_data.get('data', {}).get('listData', {}).get('List Data 1', [])
                    cleaned_rows = []

                    for item in raw_list:
                        # Detergents Mapping:
                        # Label 1: URL | Label 4: Name | Label 5: Unit | Label 6 & 7: Prices
                        p1 = clean_price(item.get('Label 6'))
                        p2 = clean_price(item.get('Label 7'))

                        # Logic: Lower price is the Final Price
                        if p1 > 0 and p2 > 0:
                            final = min(p1, p2)
                            marked = max(p1, p2)
                        else:
                            final = p1 if p1 > 0 else p2
                            marked = p2 if (p2 > p1 and p1 > 0) else None

                        cleaned_rows.append({
                            'product_name': item.get('Label 4'),
                            'unit': item.get('Label 5'),
                            'final_price': final,
                            'marked_price': marked,
                            'product_url': item.get('Label 1'),
                            'scrape_timestamp': run_data.get('startedAt'),
                            'run_id': run_data.get('id')
                        })

                    # 3. Save individual CSV
                    if cleaned_rows:
                        df = pd.DataFrame(cleaned_rows)
                        df.to_csv(csv_path, index=False, encoding='utf-8-sig')
                        print(f"  ✅ Converted: {filename}")

                except Exception as e:
                    print(f"  ⚠️ Error processing {filename}: {e}")

if __name__ == "__main__":
    process_detergents_to_csv()